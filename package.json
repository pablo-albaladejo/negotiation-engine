{
  "name": "negotiation-ring",
  "version": "0.1.0",
  "private": true,
  "description": "Agente del Bazaar (hackathon Causa Prima): el código decide la cifra; el texto es plantilla.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "viewer": "pnpm --dir viewer start",
    "viewer:test": "pnpm --dir viewer test",
    "viewer:typecheck": "pnpm --dir viewer typecheck",
    "bazaar": "tsx src/bazaar/main.ts",
    "bazaar:status": "tsx src/bazaar/status-main.ts",
    "bazaar:sim": "tsx src/bazaar/sim/sim-main.ts",
    "bazaar:venue": "tsx src/bazaar/venue-main.ts",
    "bazaar:duels": "tsx src/bazaar/duels-main.ts",
    "bazaar:trades": "tsx src/bazaar/trades-main.ts",
    "bazaar:broker": "tsx src/bazaar/broker-main.ts",
    "bazaar:scan": "node scripts/bazaar-api-scan.mjs",
    "ds:test": "pnpm --dir design-system test",
    "docs:check": "node scripts/check-agents-links.mjs; links=$?; node scripts/check-identifiers.mjs; ids=$?; [ $links -eq 0 ] && [ $ids -eq 0 ]"
  },
  "dependencies": {
    "pure-rand": "^8.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
