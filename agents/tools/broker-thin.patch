+/** Thin-pair deferral: from the marginal pair (lowest bid estimate) upward, move a pair to `held` while its posterior
+ * surplus is below share × clearing price, neither side is likely to leave after this tick and the session does not
+ * end within endTicks. Fitted offline (bench-model-v2): about +0.001 efficiency over auto, never significantly below. */
+function deferThin(runMatches: BrokerMatch[], offers: BenchQuote[], tracks: Map<string, QuoteTrack>, tick: number, thin: ThinParams, plan: BenchPlan): void {
+  const first = offers[0];
+  if (!first || runMatches.length === 0) return;
+  if (first.expiresTick === undefined || tick >= first.expiresTick - 1 - thin.endTicks) return;
+  const price = benchClearingPrice(first.run, tracks, thin.perSide, thin.hard);
+  const post = (id: string | number) => {
+    const t = tracks.get(String(id));
+    return t ? benchPosterior(t.side, t.quotes, thin.hard) : undefined;
+  };
+  for (let i = runMatches.length - 1; i >= 0; i--) {
+    const m = runMatches[i]!;
+    const b = post(m.buy);
+    const a = post(m.sell);
+    if (!b || !a || b.limit - a.limit >= thin.share * price || b.pLeave >= thin.leaveTheta || a.pLeave >= thin.leaveTheta) return;
+    const at = plan.matches.indexOf(m);
+    if (at >= 0) plan.matches.splice(at, 1);
+    if (!plan.held.includes(m)) plan.held.push(m);
+  }
+}
