+// ------------------------------------------------------------------ bench trader model (bench-model-v2)
+
+/** Calibrated prior (6 sessions, 3 Oct): limits U[10,130] bids / U[25,100] asks, first quote L(1±m), stays 1-2 ticks
+ * (impatient) or 3-6, relaxes linearly and ends k steps short of L (k 0/1/2 = 0.4/0.4/0.2). */
+const BENCH_PRIOR = { vlo: 10, vhi: 130, clo: 25, chi: 100, ask: [0.05, 0.35], bid: [0.1, 0.3], firm: 0.2, impatient: 0.25 } as const;
+const BENCH_K: ReadonlyArray<readonly [number, number]> = [[0, 0.4], [1, 0.4], [2, 0.2]];
+const M_GRID = 24;
+
+export interface BenchPosterior {
+  /** Posterior mean of the hidden limit. */
+  limit: number;
+  /** Posterior probability that it leaves after this tick. */
+  pLeave: number;
+}
+
+/** Posterior over (markup, patience, firm, k) given the quotes seen at consecutive ticks since arrival. */
+export function benchPosterior(side: "ask" | "bid", quotes: readonly number[], hard = false): BenchPosterior {
+  const q0 = quotes[0] ?? 0;
+  const j = quotes.length - 1;
+  const firmShare = hard ? 0.35 : BENCH_PRIOR.firm;
+  const imp = hard ? 0.35 : BENCH_PRIOR.impatient;
+  const patience: Array<[number, number]> = [[1, imp / 2], [2, imp / 2], ...[3, 4, 5, 6].map((p): [number, number] => [p, (1 - imp) / 4])];
+  const constant = quotes.every((q) => q === q0);
+  const [mlo, mhi] = BENCH_PRIOR[side];
+  for (const widen of [0, 0.15, 0.4]) {
+    let w = 0;
+    let wl = 0;
+    let wleave = 0;
+    const lo = Math.max(0, mlo - widen);
+    const hi = Math.min(0.9, mhi + widen);
+    for (let i = 0; i < M_GRID; i++) {
+      const m = lo + ((hi - lo) * (i + 0.5)) / M_GRID;
+      const limit = side === "ask" ? q0 / (1 + m) : q0 / (1 - m);
+      for (const [P, wp] of patience) {
+        if (P < j + 1) continue;
+        const add = (weight: number) => {
+          w += weight;
+          wl += weight * limit;
+          if (P === j + 1) wleave += weight;
+        };
+        if (constant) add(wp * (P <= 1 ? 1 : firmShare)); // firm (or a one-tick trader)
+        if (P <= 1) continue;
+        for (const [k, wk] of BENCH_K) {
+          const fits = quotes.every((q, a) => Math.abs(q0 + (limit - q0) * Math.min(1, a / (P - 1 + k)) - q) <= 1.01);
+          if (fits) add(wp * (1 - firmShare) * wk);
+        }
+      }
+    }
+    if (w > 0) return { limit: wl / w, pLeave: wleave / w };
+  }
+  return { limit: quotes[quotes.length - 1] ?? q0, pLeave: 0.5 };
+}
+
+/** Competitive-equilibrium price of the posterior limits of every trader of `run` seen so far (present or gone),
+ * plus prior quantiles for the ids not seen yet (`perSide` per side). */
+export function benchClearingPrice(run: string, tracks: Map<string, QuoteTrack>, perSide: number, hard = false): number {
+  const bids: number[] = [];
+  const asks: number[] = [];
+  for (const [id, t] of tracks) {
+    if (benchRun(id) !== run) continue;
+    (t.side === "bid" ? bids : asks).push(benchPosterior(t.side, t.quotes, hard).limit);
+  }
+  const ub = Math.max(0, perSide - bids.length);
+  const ua = Math.max(0, perSide - asks.length);
+  for (let i = 0; i < ub; i++) bids.push(BENCH_PRIOR.vlo + ((BENCH_PRIOR.vhi - BENCH_PRIOR.vlo) * (i + 0.5)) / ub);
+  for (let i = 0; i < ua; i++) asks.push(BENCH_PRIOR.clo + ((BENCH_PRIOR.chi - BENCH_PRIOR.clo) * (i + 0.5)) / ua);
+  bids.sort((a, b) => b - a);
+  asks.sort((a, b) => a - b);
+  let k = 0;
+  while (k < Math.min(bids.length, asks.length) && bids[k]! >= asks[k]!) k += 1;
+  const lo = Math.max(...(k ? [asks[k - 1]!] : []), ...(k < bids.length ? [bids[k]!] : []), 0);
+  const hi = Math.min(...(k ? [bids[k - 1]!] : []), ...(k < asks.length ? [asks[k]!] : []), Number.POSITIVE_INFINITY);
+  return Number.isFinite(hi) ? (lo + hi) / 2 : lo;
+}
