# Proveedor del LLM: none | claude-cli | anthropic-api
LLM_PROVIDER=none

# Solo si LLM_PROVIDER=anthropic-api (día del torneo). Nunca se sube a git.
ANTHROPIC_API_KEY=

# Configuración que carga el agente
AGENT_CONFIG=config/champion.json

# Autenticación de POST /turn si el ring la exige (Bearer por defecto; AGENT_AUTH_HEADER para otra cabecera)
AGENT_AUTH_TOKEN=
AGENT_AUTH_HEADER=
